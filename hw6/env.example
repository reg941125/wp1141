# LINE Bot Configuration
# 從 LINE Developers Console 取得：https://developers.line.biz/console/
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# Gemini API Configuration
# 從 Google AI Studio 取得：https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# MongoDB Configuration
# 本地 MongoDB（預設）
MONGODB_URI=mongodb://localhost:27017/line-rpg-bot
# 或使用 MongoDB Atlas（雲端）
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/line-rpg-bot

# Application Configuration
NODE_ENV=development

